# Обязательно: Токен бота из BotFather
TELEGRAM_BOT_TOKEN=123456789:AAH...

# Необязательно: Путь к файлу базы данных SQLite
DB_PATH=./data.db

# Необязательно: Отключение ручного подтверждения (Human-in-the-Loop) при отправке сообщений. 
# Установите true для автоматической отправки без подтверждения.
AUTO_APPROVE=false

# Необязательно: Часовой пояс для форматирования времени сообщений (например, Europe/Moscow)
TZ=UTC

# Необязательно: Таймаут для long-polling (в секундах, максимум 50)
POLL_TIMEOUT=25
